{
  "name": "skill-manager",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4317",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4317",
    "app": "node scripts/launch.mjs",
    "test": "vitest run",
    "probe": "node scripts/probe-vscode.mjs",
    "build:app": "node scripts/prepare-standalone.mjs clean && next build && node scripts/prepare-standalone.mjs",
    "electron:dev": "npm run build:app && node scripts/electron-dev.mjs",
    "dist": "npm run build:app && electron-builder --publish never",
    "dist:win": "npm run build:app && electron-builder --win --publish never",
    "dist:mac": "npm run build:app && electron-builder --mac --publish never",
    "dist:linux": "npm run build:app && electron-builder --linux --publish never",
    "release": "npm run build:app && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "com.andreylomako.skillmanager",
    "productName": "Skill Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app-server/node_modules"
      },
      {
        "from": "catalog",
        "to": "catalog"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Andrey Lomako",
      "synopsis": "Установка скиллов Claude Code и Codex в проекты"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "resetAdHocDarwinSignature": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AndreyLomako",
        "repo": "skill-manager",
        "releaseType": "draft"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0"
      ],
      "recommends": [
        "git"
      ]
    }
  },
  "description": "Установка скиллов Claude Code и Codex в проекты",
  "author": "Andrey Lomako",
  "homepage": "https://github.com/AndreyLomako/skill-manager"
}
